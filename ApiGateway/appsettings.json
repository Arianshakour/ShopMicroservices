{
  "ReverseProxy": {
    "Routes": { //چه درخواست هایی کجا برن
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": { //آدرس مقصد سرویس‌ها رو مشخص می‌کنه
      "product-cluster": {
        "Destinations": {
          "product-destination": {
            "Address": "http://localhost:5090/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://localhost:5211/"
          }
        }
      }
    } 
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
